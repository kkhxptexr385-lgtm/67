local function Connecter(e,f)
	local Connection = e:Connect(f)
	return Connection
end

local function Draw(type, props)
	local obj = Drawing.new(type)

	for k, v in pairs(props or {}) do obj[k] = v end

	return obj
end

local function SortAttribute(instance)
	local keys = {}

	for key in pairs(instance:GetAttributes()) do
		table.insert(keys, key)
	end

	table.sort(keys)

	return keys
end

local function WorldToViewPoint(obj)
	local pos = typeof(obj) == "Vector3" and obj or obj.Position
	local vp, onScreen = CurrentCamera:WorldToViewportPoint(pos)
	return vp, onScreen
end

local function GetDeltaY(basePositionY, currentPositionY, offset)
	local targetY = basePositionY - offset
	local deltaY = targetY - currentPositionY
	return deltaY
end

