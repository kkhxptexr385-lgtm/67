local function UserData() 
	local hand_balance = 0
	local bank_balance = 0
	if Data and Data.money then
		hand_balance = Data.money.hand or 0
		bank_balance = Data.money.bank or 0
	end
	return {
		Hand = hand_balance,
		Bank = bank_balance,
	}
end

