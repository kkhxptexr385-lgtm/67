local function setupPlayer(player)
	if player == LocalPlayer then return end
	
	player.CharacterAdded:Connect(function(character)
		if playerEspEnabled then createESP(character, true, player.Name) end
	end)
	
	if player.Character and playerEspEnabled then
		createESP(player.Character, true, player.Name)
	end
	
	task.spawn(check, player)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end

Players.PlayerAdded:Connect(function(p)
	setupPlayer(p)
	task.wait(0.2)
	if serverListEnabled then refreshServerList() end
end)

Players.PlayerRemoving:Connect(function()
	task.wait(0.2)
	if serverListEnabled then refreshServerList() end
end)

-- ระบบ NPC เกิดใหม่
Workspace.DescendantAdded:Connect(function(obj)
	if not npcEspEnabled then return end
	task.wait(0.1)
	if isNPC(obj) then
		createESP(obj, false, obj.Name)
	end
end)

for _, obj in ipairs(Workspace:GetDescendants()) do
	if isNPC(obj) then
		createESP(obj, false, obj.Name)
	end
end

-- ลูปอัปเดตระยะทางแบบประหยัดรีซอร์ส
task.spawn(function()
	while true do
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if hrp then
			for model, data in pairs(ESP_CACHE) do
				if not model:IsDescendantOf(Workspace) or data.Hum.Health <= 0 then
					removeESP(model)
				else
					local dist = (hrp.Position - data.Root.Position).Magnitude
					if data.IsPlayer then
						data.Label.Text = string.format("%s [%d m]", data.Name, math.floor(dist))
					else
						data.Label.Text = string.format("[NPC] %s [%d m]", data.Name, math.floor(dist))
					end
				end
			end
		end
		task.wait(UPDATE_FREQUENCY)
	end
end)
