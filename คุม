-- 👁️ 6. ระบบ ESP (PLAYER & NPC)
-- =======================================================
local function isNPC(model)
	if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0 and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso"))
end

local function removeESP(model)
	if ESP_CACHE[model] then
		local hl = model:FindFirstChild("ESPHighlight")
		local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
		local bb = head and head:FindFirstChild("ESPLabel")
		if hl then hl:Destroy() end
		if bb then bb:Destroy() end
		ESP_CACHE[model] = nil
	end
end

local function createESP(model, isPlayer, displayName)
	if not model or model == LocalPlayer.Character or ESP_CACHE[model] then return end
	if isPlayer and not playerEspEnabled then return end
	if not isPlayer and not npcEspEnabled then return end

	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChild("Torso")
	if not hum or not root then return end

	removeESP(model)

	local head = model:FindFirstChild("Head") or root
	local mainColor = isPlayer and PLAYER_COLOR or NPC_COLOR

	local hl = Instance.new("Highlight")
	hl.Name = "ESPHighlight"
	hl.Adornee = model
	hl.OutlineColor = mainColor
	hl.FillColor = mainColor
	hl.FillTransparency = isPlayer and 1 or 0.7
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESPLabel"
	billboard.Size = UDim2.new(0, 300, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = math.huge
	billboard.Adornee = head
	billboard.Parent = head

	local label = Instance.new("TextLabel", billboard)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = mainColor
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 13
	label.Text = displayName

	ESP_CACHE[model] = {
		Label = label,
		Root = root,
		Hum = hum,
		Name = displayName,
		IsPlayer = isPlayer
	}
end

local function clearESPType(isPlayerType)
	for model, data in pairs(ESP_CACHE) do
		if data.IsPlayer == isPlayerType then
			removeESP(model)
		end
	end
end

local function refreshESPType(isPlayerType)
	if isPlayerType then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				createESP(player.Character, true, player.Name)
			end
		end
	else
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if isNPC(obj) then
				createESP(obj, false, obj.Name)
			end
		end
	end
end

