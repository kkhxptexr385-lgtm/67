local function isFriend(uId)
	if not uId or uId == 0 then return false end
	local s, r = pcall(function() return LocalPlayer:IsFriendsWith(uId) end)
	return s and r
end

local function check(p)
	if not p or p == LocalPlayer then return end
	task.wait(1.5)
	
	if p.Name and clientBlockedList[p.Name:lower()] then
		logMessage("🚨 คนที่คุณบล็อก (" .. p.Name .. ") อยู่ในเซิร์ฟนี้!", p.Name)
		return
	end
	
	if isFriend(p.UserId) then return end
	
	local s, fId = pcall(function() return p.FollowUserId end)
	if s and fId and fId ~= 0 then
		if isFriend(fId) then
			local sn, tName = pcall(function() return Players:GetNameFromUserIdAsync(fId) end)
			if sn and tName then
				logMessage("⚠️ " .. p.Name .. " ตาม -> " .. tName, p.Name)
			else
				logMessage("⚠️ " .. p.Name .. " ตามเพื่อนคุณ [ID: " .. fId .. "]", p.Name)
			end
		end
	else
		logMessage("🚶 " .. p.Name .. " โหลดเข้าเซิร์ฟมาแล้ว", p.Name)
	end
end

