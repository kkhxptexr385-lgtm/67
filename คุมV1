local function createMoveBtn(text, pos, size)
    local btn = Instance.new("TextButton", moveControls)
    btn.Size = size or UDim2.new(0, 60, 0, 60)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.BackgroundTransparency = 0.3
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 30
    corner(btn, 10)
    return btn
end

local btnF = createMoveBtn("▲", UDim2.new(0.5, -30, 0, 0))
local btnB = createMoveBtn("▼", UDim2.new(0.5, -30, 0, 130))
local btnL = createMoveBtn("◄", UDim2.new(0, 0, 0.5, -30))
local btnR = createMoveBtn("►", UDim2.new(1, -60, 0.5, -30))

local keys = {F = 0, B = 0, L = 0, R = 0}
local moveVec = Vector3.new()

local function updateMoveVec() moveVec = Vector3.new(keys.R - keys.L, 0, keys.B - keys.F) end
local function setupSafeBtn(btn, keyName)
    btn.MouseButton1Down:Connect(function() keys[keyName] = 1; updateMoveVec() end)
    local function stop() keys[keyName] = 0; updateMoveVec() end
    btn.MouseButton1Up:Connect(stop); btn.MouseLeave:Connect(stop)
end

setupSafeBtn(btnF, "F"); setupSafeBtn(btnB, "B"); setupSafeBtn(btnL, "L"); setupSafeBtn(btnR, "R")

