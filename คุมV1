local function corner(p, r) local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 8) end
local function stroke(p, col, th) local s = Instance.new("UIStroke", p); s.Color = col or Color3.fromRGB(60, 60, 75); s.Thickness = th or 1.5 end

local function isNPC(model)
    if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0 and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso"))
end

local function removeESP(model)
    if ESP_CACHE[model] then
        local hl = model:FindFirstChild("ESPHighlight"); local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        local bb = head and head:FindFirstChild("ESPLabel"); if hl then hl:Destroy() end; if bb then bb:Destroy() end
        ESP_CACHE[model] = nil
    end
end

local function createESP(model, isPlayer, displayName)
    if not model or model == LocalPlayer.Character or ESP_CACHE[model] then return end
    if isPlayer and not playerEspEnabled or not isPlayer and not npcEspEnabled then return end
    local hum = model:FindFirstChildOfClass("Humanoid"); local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChild("Torso")
    if not hum or not root then return end
    removeESP(model)
    local head = model:FindFirstChild("Head") or root; local mainColor = isPlayer and PLAYER_COLOR or NPC_COLOR
    local hl = Instance.new("Highlight", model); hl.Name = "ESPHighlight"; hl.Adornee = model; hl.OutlineColor = mainColor; hl.FillColor = mainColor; hl.FillTransparency = isPlayer and 1 or 0.7; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    local billboard = Instance.new("BillboardGui", head); billboard.Name = "ESPLabel"; billboard.Size = UDim2.new(0, 300, 0, 80); billboard.StudsOffset = Vector3.new(0, 3, 0); billboard.AlwaysOnTop = true; billboard.Adornee = head
    local label = Instance.new("TextLabel", billboard); label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1; label.TextColor3 = mainColor; label.TextStrokeTransparency = 0; label.Font = Enum.Font.SourceSansBold; label.TextSize = 13; label.Text = displayName
    ESP_CACHE[model] = {Label = label, Root = root, Hum = hum, Name = displayName, IsPlayer = isPlayer}
end

local function clearESPType(isPlayerType) for m, d in pairs(ESP_CACHE) do if d.IsPlayer == isPlayerType then removeESP(m) end end end
local function refreshESPType(isPlayerType) if isPlayerType then for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then createESP(p.Character, true, p.Name) end end else for _, o in ipairs(Workspace:GetDescendants()) do if isNPC(o) then createESP(o, false, o.Name) end end end end
local sg = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui")); sg.Name = "DeltaMegaClearTracker"; sg.ResetOnSpawn = false

local function makeDraggable(frame, dragHandle)
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = frame.Position end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local delta = input.Position - dragStart; frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end

