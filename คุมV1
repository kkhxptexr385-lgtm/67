-- ลูป ESP
task.spawn(function()
    while true do
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for model, data in pairs(ESP_CACHE) do
                if not model:IsDescendantOf(Workspace) or data.Hum.Health <= 0 then removeESP(model)
                else
                    local dist = (hrp.Position - data.Root.Position).Magnitude
                    data.Label.Text = string.format("%s [%d m]", data.Name, math.floor(dist))
                end
            end
        end
        task.wait(UPDATE_FREQUENCY)
    end
end)

