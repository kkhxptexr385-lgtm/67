RunService.RenderStepped:Connect(function()
    if isFreecam then
        local cf = Camera.CFrame
        local calculatedSpeed = moveSpeed / 70
        local moveDir = (cf.LookVector * -moveVec.Z) + (cf.RightVector * moveVec.X)
        Camera.CFrame = cf + (moveDir * calculatedSpeed)
    end
end)
